
@model Decision_Module.Pages.Underwriting.CoverView

@{
    var c = Model.Cover;
    var pg = Model.Page;
    var f = pg.FormForCover(c);

    var isOpen = pg.OpenUwId == c.UwId;
    var allowedExtras = pg.AllowedExtras(c);
    var showPostpone = pg.Shows(f.DecisionId, "PostponePeriod");
    var showExtras = pg.Shows(f.DecisionId, "Extras");

    var title = c.CoverType == "BASE"
        ? "Base cover"
        : (c.RiderType ?? "Rider").Replace('_', ' ');

    var extraFields = new (string Name, string Label, decimal? Value)[]
    {
        ("EMR", "EMR", f.EMR),
        ("OccupationExtra", "Occupation extra", f.OccupationExtra),
        ("ResidentialExtra", "Residential extra", f.ResidentialExtra),
        ("FlatExtra", "Flat extra", f.FlatExtra),
        ("AgeExtra", "Age extra", f.AgeExtra)
    };
}

<div class="border rounded p-2 mb-2 bg-body">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <strong>@title</strong>

        <span class="text-muted small">@c.BenefitCode</span>

        @if (c.RiderId is not null)
        {
            <span class="text-muted small">
                &middot; @c.RiderId
            </span>
        }

        <span class="ms-auto">
            @(c.DecisionName ?? "No decision yet")

            @if (c.DecisionSource is not null)
            {
                <span class="badge @pg.SourceBadge(c.DecisionSource)">
                    @c.SourceLabel
                </span>
            }
        </span>
    </div>

    <div class="small text-muted">
        Term @(c.Bterm?.ToString() ?? "-") &middot;
        Premium paying term @(c.Bppt?.ToString() ?? "-") &middot;
        Premium @(c.BenefitInstalmentPremium?.ToString("N0") ?? "-") &middot;
        Sum assured @(c.BenefitSumAssured?.ToString("N0") ?? "-")
    </div>

    @if (c.ReasonText is not null && c.ReasonText != c.DecisionName)
    {
        <div class="small">
            Reason: @c.ReasonText
        </div>
    }

    @if (c.Details().Any())
    {
        <div class="mt-1">
            @foreach (var detail in c.Details())
            {
                <span class="badge text-bg-light border me-1">
                    @detail
                </span>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(c.Notes))
    {
        <div class="small text-muted">
            Note: @c.Notes
        </div>
    }

    <div class="mt-2 d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#edit-@c.UwId"
                aria-expanded="@(isOpen ? "true" : "false")"
                aria-controls="edit-@c.UwId">
            Edit
        </button>

        @if (c.DecisionSource == "OVERRIDE")
        {
            <form method="post"
                  asp-page-handler="ResetCover"
                  class="d-inline"
                  onsubmit="return confirm('Return this cover to the global decision?');">

                <input type="hidden"
                       name="CustomerId"
                       value="@pg.CustomerId" />

                <input type="hidden"
                       name="Form.UwId"
                       value="@c.UwId" />

                <button type="submit"
                        class="btn btn-sm btn-outline-secondary">
                    Reset to global
                </button>
            </form>
        }
    </div>

    <div class="collapse @(isOpen ? "show" : "")"
         id="edit-@c.UwId">

        <form method="post"
              asp-page-handler="SaveCover"
              class="mt-3"
              data-decision-form>

            <input type="hidden"
                   name="CustomerId"
                   value="@pg.CustomerId" />

            <input type="hidden"
                   name="Form.UwId"
                   value="@c.UwId" />

            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label"
                           for="decision-@c.UwId">
                        Decision
                    </label>

                    <select class="form-select js-decision"
                            id="decision-@c.UwId"
                            name="Form.DecisionId">

                        <option value="">Select decision...</option>

                        @foreach (var decision in pg.Decisions)
                        {
                            var fields = new List<string>();

                            if (pg.Shows(decision.DecisionId, "PostponePeriod"))
                            {
                                fields.Add("PostponePeriod");
                            }

                            if (pg.Shows(decision.DecisionId, "Extras"))
                            {
                                fields.Add("Extras");
                            }

                            <option value="@decision.DecisionId"
                                    data-fields="@string.Join(",", fields)"
                                    selected="@(f.DecisionId == decision.DecisionId)">
                                @decision.DecisionName
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label"
                           for="reason-@c.UwId">
                        Reason
                    </label>

                    <select class="form-select js-reason"
                            id="reason-@c.UwId"
                            name="Form.ReasonId">

                        <option value="">Select reason...</option>

                        @foreach (var reason in pg.Reasons)
                        {
                            <option value="@reason.ReasonId"
                                    data-decision="@reason.DecisionId"
                                    selected="@(f.ReasonId == reason.ReasonId)">
                                @reason.ReasonText
                            </option>
                        }
                    </select>

                    <div class="form-text js-reason-hint"></div>
                </div>

                <div class="col-md-4 js-postpone"
                     hidden="@(!showPostpone)">

                    <label class="form-label"
                           for="postpone-@c.UwId">
                        Postpone period
                    </label>

                    <input type="number"
                           min="0"
                           max="999"
                           class="form-control"
                           id="postpone-@c.UwId"
                           name="Form.PostponePeriod"
                           value="@f.PostponePeriod" />
                </div>

                <div class="col-12 js-extras"
                     hidden="@(!showExtras)">

                    <div class="small fw-semibold">Extras</div>

                    @if (allowedExtras.Count == 0)
                    {
                        <div class="form-text">
                            No extras apply to this type of cover.
                        </div>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var extra in extraFields)
                            {
                                if (allowedExtras.Contains(extra.Name))
                                {
                                    <div class="col-6 col-md-4">
                                        <label class="form-label small"
                                               for="@(extra.Name)-@c.UwId">
                                            @extra.Label
                                        </label>

                                        <input type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control form-control-sm"
                                               id="@(extra.Name)-@c.UwId"
                                               name="@("Form." + extra.Name)"
                                               value="@pg.Dec(extra.Value)" />
                                    </div>
                                }
                            }
                        </div>

                        <div class="form-text">
                            Leave a box empty for "not set".
                            Empty is not the same as 0.
                        </div>
                    }
                </div>

                <div class="col-12">
                    <label class="form-label"
                           for="notes-@c.UwId">
                        Notes
                    </label>

                    <input type="text"
                           maxlength="500"
                           class="form-control"
                           id="notes-@c.UwId"
                           name="Form.Notes"
                           value="@f.Notes" />
                </div>
            </div>

            <button type="submit"
                    class="btn btn-primary btn-sm mt-3">
                Save
            </button>
        </form>
    </div>
</div>
