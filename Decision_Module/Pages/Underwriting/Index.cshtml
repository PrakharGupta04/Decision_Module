@page
@model Decision_Module.Pages.Underwriting.IndexModel

@{
    ViewData["Title"] = "Underwriting Decision";
}

<h1 class="h3 mb-3">Underwriting Decision</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label asp-for="CustomerId" class="visually-hidden">
            Customer ID
        </label>
        <input asp-for="CustomerId"
               class="form-control"
               placeholder="Customer ID"
               maxlength="20"
               autofocus />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.Success is not null)
{
    <div class="alert alert-success">@Model.Success</div>
}

@if (Model.Warning is not null)
{
    <div class="alert alert-warning">@Model.Warning</div>
}

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Messages.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var message in Model.Messages)
            {
                <li>@message</li>
            }
        </ul>
    </div>
}

@if (Model.Customer is not null)
{
    <div class="card mb-3">
        <div class="card-header">Customer details</div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Customer ID</dt>
                <dd class="col-sm-9">@Model.Customer.CustomerId</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Customer.CustomerName</dd>

                <dt class="col-sm-3">Benefit group</dt>
                <dd class="col-sm-9">
                    @(Model.Customer.BenefitGroupId ?? "-")
                </dd>

                <dt class="col-sm-3">Reinsurer</dt>
                <dd class="col-sm-9">
                    @(Model.Customer.ReinsurerId ?? "-")
                </dd>
            </dl>
        </div>
    </div>

    <partial name="_GlobalCards" model="Model" />

    <h2 class="h5">Policies</h2>

    @if (Model.Policies.Count == 0)
    {
        <div class="alert alert-secondary">
            No policies on record for this customer.
        </div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Policy no.</th>
                    <th>Product</th>
                    <th>Benefit code</th>
                    <th>Decision</th>
                    <th>Source</th>
                </tr>
            </thead>

            <tbody>
                @for (var i = 0; i < Model.Policies.Count; i++)
                {
                    var policy = Model.Policies[i];
                    var riders = Model.RidersByPolicy[policy.PolicyNumber].ToList();
                    var isOpen = Model.OpenPolicy == policy.PolicyNumber;

                    <tr>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#policy-@i"
                                    aria-expanded="@(isOpen ? "true" : "false")"
                                    aria-controls="policy-@i">
                                Details
                            </button>
                        </td>

                        <td>@policy.PolicyNumber</td>
                        <td>@policy.MarketName</td>
                        <td>@policy.BenefitCode</td>
                        <td>@(policy.DecisionName ?? "No decision yet")</td>

                        <td>
                            @if (policy.DecisionSource is not null)
                            {
                                <span class="badge @Model.SourceBadge(policy.DecisionSource)">
                                    @policy.SourceLabel
                                </span>
                            }
                        </td>
                    </tr>

                    <tr>
                        <td colspan="6" class="p-0 border-0">
                            <div class="collapse @(isOpen ? "show" : "")"
                                 id="policy-@i">
                                <div class="p-3 bg-body-tertiary">
                                    <p class="small text-muted">
                                        Billing frequency:
                                        @(policy.BillingFrequency?.ToString() ?? "-")
                                    </p>

                                    <partial name="_CoverEditor"
                                             model="new CoverView(policy, Model)" />

                                    <h3 class="h6 mt-3">Riders</h3>

                                    @if (riders.Count == 0)
                                    {
                                        <p class="text-muted mb-0">
                                            No riders on this policy.
                                        </p>
                                    }
                                    else
                                    {
                                        @foreach (var rider in riders)
                                        {
                                            <partial name="_CoverEditor"
                                                     model="new CoverView(rider, Model)" />
                                        }
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@section Scripts {
    <script src="~/js/underwriting.js"
            asp-append-version="true"></script>
}