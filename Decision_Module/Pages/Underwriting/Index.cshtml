@page
@model Decision_Module.Pages.Underwriting.IndexModel
@{
    ViewData["Title"] = "Underwriting Decision";
}

<h1 class="h3 mb-3">Underwriting Decision</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label asp-for="CustomerId" class="visually-hidden">Customer ID</label>
        <input asp-for="CustomerId" class="form-control" placeholder="Customer ID" maxlength="20" autofocus />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.Success is not null)
{
    <div class="alert alert-success">@Model.Success</div>
}
@if (Model.Warning is not null)
{
    <div class="alert alert-warning">@Model.Warning</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
@if (Model.Messages.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var message in Model.Messages)
            {
                <li>@message</li>
            }
        </ul>
    </div>
}

@if (Model.Customer is not null)
{
    var cards = new (string Type, string Title)[] { ("BASE", "Base cover"), ("RIDER", "Riders") };

    <div class="card mb-3">
        <div class="card-header">Customer details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <div class="small text-muted">Customer ID</div>
                    <div>@Model.Customer.CustomerId</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="small text-muted">Name</div>
                    <div>@Model.Customer.CustomerName</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="small text-muted">Benefit group</div>
                    <div>@(Model.Customer.BenefitGroupId ?? "-")</div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="small text-muted">Reinsurer</div>
                    <div>@(Model.Customer.ReinsurerId ?? "Not assigned")</div>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5">Global decision <small class="text-muted">(this customer only)</small></h2>
    <div class="row g-3 mb-4">
        @foreach (var card in cards)
        {
            var globalForm = Model.FormForGlobal(card.Type);
            var affected = Model.AffectedCovers(card.Type);
            var kept = Model.KeptCovers(card.Type);
            var hasCovers = Model.CoverCount(card.Type) > 0;
            var confirmText = $"Apply this decision to {affected.Count} cover(s) and keep {kept.Count} with their own decision?";

            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">@card.Title</div>
                    <div class="card-body">
                        <p class="small text-muted mb-2">Current global decision: @Model.CurrentGlobalLabel(card.Type)</p>

                        @if (!hasCovers)
                        {
                            <div class="alert alert-secondary py-2">This customer has no @(card.Title.ToLower()) to decide on.</div>
                        }

                        <form method="post" asp-page-handler="SaveGlobal" data-decision-form
                              onsubmit="return confirm('@confirmText');">
                            <fieldset disabled="@(!hasCovers)">
                                <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
                                <input type="hidden" name="Form.CoverType" value="@card.Type" />

                                <div class="mb-2">
                                    <label class="form-label" for="decision-@card.Type">Decision</label>
                                    <select class="form-select js-decision" id="decision-@card.Type" name="Form.DecisionId">
                                        <option value="">Select decision...</option>
                                        @foreach (var option in Model.Decisions)
                                        {
                                            <option value="@option.DecisionId" data-fields="@Model.FieldsCsv(option.DecisionId)"
                                                    selected="@(globalForm.DecisionId == option.DecisionId)">@option.DecisionName</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label" for="reason-@card.Type">Reason <span class="text-danger js-reason-star" hidden>*</span></label>
                                    <textarea class="form-control js-reason" id="reason-@card.Type" name="Form.ReasonText" rows="2"
                                              maxlength="500" placeholder="Type the reason for this decision">@globalForm.ReasonText</textarea>
                                </div>

                                @if (hasCovers)
                                {
                                    <div class="small">
                                        <div><strong>Will apply to (@affected.Count):</strong> @(affected.Count == 0 ? "none" : string.Join(", ", affected))</div>
                                        @if (kept.Count > 0)
                                        {
                                            <div class="text-muted"><strong>Kept, own decision (@kept.Count):</strong> @string.Join(", ", kept)</div>
                                        }
                                    </div>
                                }

                                <button type="submit" class="btn btn-primary btn-sm mt-3">Apply global decision</button>
                            </fieldset>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="h5">Policies</h2>
    @if (Model.Policies.Count == 0)
    {
        <div class="alert alert-secondary">No policies on record for this customer.</div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Policy no.</th>
                    <th>Product</th>
                    <th>Benefit code</th>
                    <th>Riders</th>
                    <th>Decision</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Policies.Count; i++)
                {
                    var policy = Model.Policies[i];
                    var riders = Model.RidersByPolicy[policy.PolicyNumber].ToList();
                    var covers = new[] { policy }.Concat(riders).ToList();
                    var policyOpen = Model.OpenPolicy == policy.PolicyNumber;
                    var ridersHeadingShown = false;

                    <tr>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#policy-@i" aria-expanded="@(policyOpen ? "true" : "false")"
                                    aria-controls="policy-@i">
                                Details
                            </button>
                        </td>
                        <td>@policy.PolicyNumber</td>
                        <td>@policy.MarketName</td>
                        <td>@policy.BenefitCode</td>
                        <td>@riders.Count</td>
                        <td>@(policy.DecisionName ?? "No decision yet")</td>
                        <td>
                            @if (policy.DecisionSource is not null)
                            {
                                <span class="badge @Model.SourceBadge(policy.DecisionSource)">@policy.SourceLabel</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td colspan="7" class="p-0 border-0">
                            <div class="collapse @(policyOpen ? "show" : "")" id="policy-@i">
                                <div class="p-3 bg-body-tertiary">
                                    <p class="small text-muted">Billing frequency: @(policy.BillingFrequency?.ToString() ?? "-")</p>

                                    @foreach (var cover in covers)
                                    {
                                        if (cover.CoverType == "RIDER" && !ridersHeadingShown)
                                        {
                                            ridersHeadingShown = true;
                                            <h3 class="h6 mt-3">Riders</h3>
                                        }

                                        var coverForm = Model.FormForCover(cover);
                                        var editOpen = Model.OpenUwId == cover.UwId;
                                        var allowedExtras = Model.AllowedExtras(cover);
                                        var showPostpone = Model.Shows(coverForm.DecisionId, "PostponePeriod");
                                        var showExtras = Model.Shows(coverForm.DecisionId, "Extras");
                                        var coverTitle = cover.CoverType == "BASE" ? "Base cover" : (cover.RiderType ?? "Rider").Replace('_', ' ');
                                        var extraFields = new (string Name, string Label, decimal? Value)[]
                                        {
                                        ("EMR", "EMR", coverForm.EMR),
                                        ("OccupationExtra", "Occupation extra", coverForm.OccupationExtra),
                                        ("ResidentialExtra", "Residential extra", coverForm.ResidentialExtra),
                                        ("FlatExtra", "Flat extra", coverForm.FlatExtra),
                                        ("AgeExtra", "Age extra", coverForm.AgeExtra)
                                        };

                                        <div class="border rounded p-2 mb-2 bg-body">
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <strong>@coverTitle</strong>
                                                <span class="text-muted small">@cover.BenefitCode</span>
                                                @if (cover.RiderId is not null)
                                                {
                                                    <span class="text-muted small">&middot; @cover.RiderId</span>
                                                }
                                                <span class="ms-auto">
                                                    @(cover.DecisionName ?? "No decision yet")
                                                    @if (cover.DecisionSource is not null)
                                                    {
                                                        <span class="badge @Model.SourceBadge(cover.DecisionSource)">@cover.SourceLabel</span>
                                                    }
                                                </span>
                                            </div>

                                            <div class="small text-muted">
                                                Term @(cover.Bterm?.ToString() ?? "-") &middot;
                                                Premium paying term @(cover.Bppt?.ToString() ?? "-") &middot;
                                                Premium @(cover.BenefitInstalmentPremium?.ToString("N0") ?? "-") &middot;
                                                Sum assured @(cover.BenefitSumAssured?.ToString("N0") ?? "-")
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(cover.ReasonText))
                                            {
                                                <div class="small">Reason: @cover.ReasonText</div>
                                            }
                                            @if (cover.Details().Any())
                                            {
                                                <div class="mt-1">
                                                    @foreach (var detail in cover.Details())
                                                    {
                                                        <span class="badge text-bg-light border me-1">@detail</span>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(cover.Notes))
                                            {
                                                <div class="small text-muted">Note: @cover.Notes</div>
                                            }

                                            <div class="mt-2 d-flex gap-2">
                                                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse"
                                                        data-bs-target="#edit-@cover.UwId" aria-expanded="@(editOpen ? "true" : "false")"
                                                        aria-controls="edit-@cover.UwId">
                                                    Edit
                                                </button>

                                                @if (cover.DecisionSource == "OVERRIDE")
                                                {
                                                    <form method="post" asp-page-handler="ResetCover" class="d-inline"
                                                          onsubmit="return confirm('Return this cover to the global decision?');">
                                                        <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
                                                        <input type="hidden" name="Form.UwId" value="@cover.UwId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Reset to global</button>
                                                    </form>
                                                }
                                            </div>

                                            <div class="collapse @(editOpen ? "show" : "")" id="edit-@cover.UwId">
                                                <form method="post" asp-page-handler="SaveCover" class="mt-3" data-decision-form>
                                                    <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
                                                    <input type="hidden" name="Form.UwId" value="@cover.UwId" />

                                                    <div class="row g-2">
                                                        <div class="col-md-6">
                                                            <label class="form-label" for="decision-@cover.UwId">Decision</label>
                                                            <select class="form-select js-decision" id="decision-@cover.UwId" name="Form.DecisionId">
                                                                <option value="">Select decision...</option>
                                                                @foreach (var option in Model.Decisions)
                                                                {
                                                                    <option value="@option.DecisionId" data-fields="@Model.FieldsCsv(option.DecisionId)"
                                                                            selected="@(coverForm.DecisionId == option.DecisionId)">@option.DecisionName</option>
                                                                }
                                                            </select>
                                                        </div>

                                                        <div class="col-md-6 js-postpone" hidden="@(!showPostpone)">
                                                            <label class="form-label" for="postpone-@cover.UwId">Postpone period</label>
                                                            <input type="number" min="0" max="999" class="form-control" id="postpone-@cover.UwId"
                                                                   name="Form.PostponePeriod" value="@coverForm.PostponePeriod" />
                                                        </div>

                                                        <div class="col-12">
                                                            <label class="form-label" for="reason-@cover.UwId">Reason <span class="text-danger js-reason-star" hidden>*</span></label>
                                                            <textarea class="form-control js-reason" id="reason-@cover.UwId" name="Form.ReasonText" rows="2"
                                                                      maxlength="500" placeholder="Type the reason for this decision">@coverForm.ReasonText</textarea>
                                                        </div>

                                                        <div class="col-12 js-extras" hidden="@(!showExtras)">
                                                            <div class="small fw-semibold">Extras</div>
                                                            @if (allowedExtras.Count == 0)
                                                            {
                                                                <div class="form-text">No extras apply to this type of cover.</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="row g-2">
                                                                    @foreach (var extra in extraFields)
                                                                    {
                                                                        if (allowedExtras.Contains(extra.Name))
                                                                        {
                                                                            var inputId = extra.Name + "-" + cover.UwId;
                                                                            var inputName = "Form." + extra.Name;

                                                                            <div class="col-6 col-md-4">
                                                                                <label class="form-label small" for="@inputId">@extra.Label</label>
                                                                                <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                                                                       id="@inputId" name="@inputName" value="@Model.Dec(extra.Value)" />
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                                <div class="form-text">Leave a box empty for "not set". Empty is not the same as 0.</div>
                                                            }
                                                        </div>

                                                        <div class="col-12">
                                                            <label class="form-label" for="notes-@cover.UwId">Notes</label>
                                                            <input type="text" maxlength="500" class="form-control" id="notes-@cover.UwId"
                                                                   name="Form.Notes" value="@coverForm.Notes" />
                                                        </div>
                                                    </div>

                                                    <button type="submit" class="btn btn-primary btn-sm mt-3">Save</button>
                                                </form>
                                            </div>
                                        </div>
                                    }

                                    @if (riders.Count == 0)
                                    {
                                        <h3 class="h6 mt-3">Riders</h3>
                                        <p class="text-muted mb-0">No riders on this policy.</p>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@section Scripts {
    <script src="~/js/underwriting.js" asp-append-version="true"></script>
}