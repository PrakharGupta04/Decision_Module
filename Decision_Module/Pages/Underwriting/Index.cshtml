
@page
@model Decision_Module.Pages.Underwriting.IndexModel
@{
    ViewData["Title"] = "Underwriting Decision";
}

<h1 class="h3 mb-3">Underwriting Decision</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label asp-for="CustomerId" class="visually-hidden">Customer ID</label>
        <input asp-for="CustomerId" class="form-control" placeholder="Customer ID" maxlength="20" autofocus />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (Model.Success is not null)
{
    <div class="alert alert-success">@Model.Success</div>
}
@if (Model.Warning is not null)
{
    <div class="alert alert-warning">@Model.Warning</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
@if (Model.Customer is not null && !Model.ModelState.IsValid)
{
    <div class="alert alert-danger">Nothing was saved. Please fix the fields marked in red.</div>
}

@if (Model.Customer is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-lg">
                    <div class="small text-muted">Customer ID</div>
                    <div class="fw-semibold">@Model.Customer.CustomerId</div>
                </div>
                <div class="col-6 col-lg">
                    <div class="small text-muted">Name</div>
                    <div class="fw-semibold">@Model.Customer.CustomerName</div>
                </div>
                <div class="col-6 col-lg">
                    <div class="small text-muted">Benefit group</div>
                    <div>@(Model.Customer.BenefitGroupId ?? "-")</div>
                </div>
                <div class="col-6 col-lg">
                    <div class="small text-muted">Reinsurer ID</div>
                    <div>@(Model.Customer.ReinsurerId ?? "-")</div>
                </div>
                <div class="col-6 col-lg">
                    <div class="small text-muted">Policies</div>
                    <div>@Model.Policies.Count</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Policies.Count == 0)
    {
        <div class="alert alert-secondary">No policies on record for this customer.</div>
    }
    else
    {
        <form method="post">
            <input type="hidden" name="CustomerId" value="@Model.CustomerId" />

            <h2 class="h5">Global decisions</h2>
            <div class="card mb-4">
                <ul class="list-group list-group-flush">
                    @for (var g = 0; g < Model.GlobalKinds.Count; g++)
                    {
                        var kind = Model.GlobalKinds[g];
                        var globalInput = Model.GlobalInputs[g];
                        var prefix = $"GlobalInputs[{g}]";

                        <li class="list-group-item block global-block" data-kind="@kind.Code">
                            <div class="row g-3">
                                <div class="col-md-2">
                                    <input type="hidden" name="@(prefix).Kind" value="@kind.Code" />
                                    <div class="form-check">
                                        <input class="form-check-input rounded-circle js-on"
                                               type="checkbox"
                                               id="on-@g"
                                               name="@(prefix).On"
                                               value="true"
                                               checked="@globalInput.On" />
                                        <label class="form-check-label fw-semibold" for="on-@g">
                                            @kind.Label
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label small mb-1" for="decision-g@(g)">Decision</label>
                                    <select class="form-select form-select-sm js-decision"
                                            id="decision-g@(g)"
                                            name="@(prefix).DecisionId">
                                        <option value="">Select decision...</option>
                                        @foreach (var decision in Model.Decisions)
                                        {
                                            <option value="@decision.DecisionId"
                                                    data-fields="@Model.FieldsCsv(decision.DecisionId)"
                                                    selected="@(globalInput.DecisionId == decision.DecisionId)">
                                                @decision.DecisionName
                                            </option>
                                        }
                                    </select>
                                    @Html.ValidationMessage(prefix + ".DecisionId", new { @class = "text-danger small" })
                                </div>

                                <div class="col-md-7">
                                    <div class="form-label small mb-1">
                                        Reasons and their sub-reasons
                                        <span class="text-danger js-reason-required" hidden>*</span>
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label small mb-1" for="reason-search-g@(g)">
                                            Search reasons
                                        </label>
                                        <input type="search"
                                               class="form-control form-control-sm js-reason-search"
                                               id="reason-search-g@(g)"
                                               placeholder="Type a reason or sub-reason..."
                                               autocomplete="off" />
                                    </div>

                                    <div class="js-reasons">
                                        @foreach (var reason in Model.ReasonsFor(kind.Code))
                                        {
                                            var selectedReason = globalInput.Reasons.FirstOrDefault(r => r.ReasonId == reason.ReasonId);
                                            var reasonName = $"{prefix}.Reasons[{reason.ReasonId}]";

                                            <input type="hidden"
                                                   name="@(prefix).Reasons.Index"
                                                   value="@reason.ReasonId" />

                                            <div class="border rounded p-2 mb-2 js-reason-group"
                                                 data-reason="@reason.ReasonId"
                                                 data-decision="@reason.DecisionId"
                                                 data-reason-text="@reason.ReasonText">
                                                <div class="form-check">
                                                    <input class="form-check-input js-reason-check"
                                                           type="checkbox"
                                                           id="reason-g@(g)-@reason.ReasonId"
                                                           name="@(reasonName).ReasonId"
                                                           value="@reason.ReasonId"
                                                           checked="@(selectedReason is not null)" />
                                                    <label class="form-check-label"
                                                           for="reason-g@(g)-@reason.ReasonId">
                                                        @reason.ReasonText
                                                    </label>
                                                </div>

                                                @foreach (var sub in Model.SubReasonsFor(kind.Code).Where(s => s.ReasonId == reason.ReasonId))
                                                {
                                                    <div class="form-check ms-4 js-sub-item"
                                                         data-subreason-text="@sub.SubReasonText">
                                                        <input class="form-check-input js-sub"
                                                               type="checkbox"
                                                               id="sub-g@(g)-@sub.SubReasonId"
                                                               name="@(reasonName).SubReasonIds"
                                                               value="@sub.SubReasonId"
                                                               checked="@(selectedReason?.SubReasonIds.Contains(sub.SubReasonId) ?? false)" />
                                                        <label class="form-check-label small"
                                                               for="sub-g@(g)-@sub.SubReasonId">
                                                            @sub.SubReasonText
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @Html.ValidationMessage(prefix + ".Reasons", new { @class = "text-danger small" })
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label small mb-1" for="notes-g@(g)">Global note</label>
                                    <input type="text"
                                           maxlength="500"
                                           class="form-control form-control-sm js-global-notes"
                                           id="notes-g@(g)"
                                           name="@(prefix).Notes"
                                           value="@globalInput.Notes" />
                                    @Html.ValidationMessage(prefix + ".Notes", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <h2 class="h5">Policies</h2>

            @foreach (var policy in Model.Policies)
            {
                var covers = Model.CoversOf(policy);
                var frequency = policy.FrequencyLabel ?? policy.PaymentFrequency ?? "-";

                <div class="card mb-4">
                    <div class="card-header">
                        <div class="row g-3">
                            <div class="col-6 col-lg-2">
                                <div class="small text-muted">Policy number</div>
                                <div class="fw-semibold">@policy.PolicyNumber</div>
                            </div>
                            <div class="col-6 col-lg-4">
                                <div class="small text-muted">Product</div>
                                <div>
                                    @policy.MarketName
                                    <span class="text-muted small">@policy.BenefitGroup</span>
                                </div>
                            </div>
                            <div class="col-6 col-lg-2">
                                <div class="small text-muted">Benefit code</div>
                                <div>@policy.BenefitCode</div>
                            </div>
                            <div class="col-6 col-lg-2">
                                <div class="small text-muted">Riders</div>
                                <div>@(covers.Count - 1)</div>
                            </div>
                            <div class="col-6 col-lg-2">
                                <div class="small text-muted">Reinsurer ID</div>
                                <div>@(policy.ReinsurerId ?? "-")</div>
                            </div>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush">
                        @foreach (var cover in covers)
                        {
                            var index = Model.Covers.IndexOf(cover);
                            var input = Model.CoverInputs[index];
                            var prefix = $"CoverInputs[{index}]";
                            var kind = Model.KindOf(cover);
                            var isBase = cover.CoverType == "BASE";
                            var allowedExtras = Model.AllowedExtras(cover);

                            <li class="list-group-item block cover-block" data-kind="@kind">
                                <input type="hidden" name="@(prefix).UwId" value="@cover.UwId" />

                                <div class="d-flex flex-wrap align-items-baseline column-gap-4 row-gap-1 mb-3 small">
                                    <span class="fs-6 fw-semibold">
                                        @(isBase ? "Base cover" : cover.RiderTypeName)
                                    </span>
                                    <span class="text-muted">@(isBase ? cover.BaseCoverId : cover.RiderId)</span>

                                    @if (isBase && cover.BaseCoverType is not null)
                                    {
                                        <span class="badge text-bg-light border">@cover.BaseCoverType</span>
                                    }

                                    <span>
                                        Sum assured:
                                        <strong>@(cover.BenefitSumAssured?.ToString("N0") ?? "-")</strong>
                                    </span>
                                    <span>
                                        Premium:
                                        <strong>@(cover.BenefitInstalmentPremium?.ToString("N0") ?? "-")</strong>
                                    </span>
                                    <span>Frequency: <strong>@frequency</strong></span>
                                    <span>Term (bterm): <strong>@(cover.Bterm?.ToString() ?? "-")</strong></span>
                                    <span>Premium paying term (bppt): <strong>@(cover.Bppt?.ToString() ?? "-")</strong></span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-2">
                                        <label class="form-label small mb-1" for="source-@index">Source</label>
                                        <select class="form-select form-select-sm js-source"
                                                id="source-@index"
                                                name="@(prefix).Source">
                                            <option value="GLOBAL" selected="@(input.Source == "GLOBAL")">Global</option>
                                            <option value="OVERRIDE" selected="@(input.Source == "OVERRIDE")">Override</option>
                                        </select>
                                        @Html.ValidationMessage(prefix + ".Source", new { @class = "text-danger small" })
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label small mb-1" for="decision-c@(index)">Decision</label>
                                        <select class="form-select form-select-sm js-decision"
                                                id="decision-c@(index)"
                                                name="@(prefix).DecisionId">
                                            <option value="">Select decision...</option>
                                            @foreach (var decision in Model.Decisions)
                                            {
                                                <option value="@decision.DecisionId"
                                                        data-fields="@Model.FieldsCsv(decision.DecisionId)"
                                                        selected="@(input.DecisionId == decision.DecisionId)">
                                                    @decision.DecisionName
                                                </option>
                                            }
                                        </select>
                                        @Html.ValidationMessage(prefix + ".DecisionId", new { @class = "text-danger small" })
                                    </div>

                                    <div class="col-md-7">
                                        <div class="form-label small mb-1">
                                            Reasons and their sub-reasons
                                            <span class="text-danger js-reason-required" hidden>*</span>
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label small mb-1" for="reason-search-c@(index)">
                                                Search reasons
                                            </label>
                                            <input type="search"
                                                   class="form-control form-control-sm js-reason-search"
                                                   id="reason-search-c@(index)"
                                                   placeholder="Type a reason or sub-reason..."
                                                   autocomplete="off" />
                                        </div>

                                        <div class="js-reasons">
                                            @foreach (var reason in Model.ReasonsFor(kind))
                                            {
                                                var selectedReason = input.Reasons.FirstOrDefault(r => r.ReasonId == reason.ReasonId);
                                                var reasonName = $"{prefix}.Reasons[{reason.ReasonId}]";

                                                <input type="hidden"
                                                       name="@(prefix).Reasons.Index"
                                                       value="@reason.ReasonId" />

                                                <div class="border rounded p-2 mb-2 js-reason-group"
                                                     data-reason="@reason.ReasonId"
                                                     data-decision="@reason.DecisionId"
                                                     data-reason-text="@reason.ReasonText">
                                                    <div class="form-check">
                                                        <input class="form-check-input js-reason-check"
                                                               type="checkbox"
                                                               id="reason-c@(index)-@reason.ReasonId"
                                                               name="@(reasonName).ReasonId"
                                                               value="@reason.ReasonId"
                                                               checked="@(selectedReason is not null)" />
                                                        <label class="form-check-label"
                                                               for="reason-c@(index)-@reason.ReasonId">
                                                            @reason.ReasonText
                                                        </label>
                                                    </div>

                                                    @foreach (var sub in Model.SubReasonsFor(kind).Where(s => s.ReasonId == reason.ReasonId))
                                                    {
                                                        <div class="form-check ms-4 js-sub-item"
                                                             data-subreason-text="@sub.SubReasonText">
                                                            <input class="form-check-input js-sub"
                                                                   type="checkbox"
                                                                   id="sub-c@(index)-@sub.SubReasonId"
                                                                   name="@(reasonName).SubReasonIds"
                                                                   value="@sub.SubReasonId"
                                                                   checked="@(selectedReason?.SubReasonIds.Contains(sub.SubReasonId) ?? false)" />
                                                            <label class="form-check-label small"
                                                                   for="sub-c@(index)-@sub.SubReasonId">
                                                                @sub.SubReasonText
                                                            </label>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @Html.ValidationMessage(prefix + ".Reasons", new { @class = "text-danger small" })
                                    </div>
                                </div>

                                <div class="row g-3 mt-0">
                                    <div class="col-md-2 js-postpone"
                                         hidden="@(!Model.Shows(input.DecisionId, "PostponePeriod"))">
                                        <label class="form-label small mb-1" for="postpone-@index">Postpone period</label>
                                        <input type="number"
                                               min="0"
                                               max="999"
                                               class="form-control form-control-sm"
                                               id="postpone-@index"
                                               name="@(prefix).PostponePeriod"
                                               value="@input.PostponePeriod" />
                                        @Html.ValidationMessage(prefix + ".PostponePeriod", new { @class = "text-danger small" })
                                    </div>

                                    <div class="col-md-6 js-extras"
                                         hidden="@(!Model.Shows(input.DecisionId, "Extras"))">
                                        @if (allowedExtras.Count == 0)
                                        {
                                            <div class="form-text">No extras apply to this type of cover.</div>
                                        }
                                        else
                                        {
                                            <div class="row g-2">
                                                @foreach (var extra in Model.ExtraFields)
                                                {
                                                    if (!allowedExtras.Contains(extra.Name))
                                                    {
                                                        continue;
                                                    }

                                                    var extraName = prefix + "." + extra.Name;

                                                    <div class="col-6 col-md-4">
                                                        <label class="form-label small mb-1"
                                                               for="@(extra.Name)-@index">
                                                            @extra.Label
                                                        </label>
                                                        <input type="number"
                                                               step="0.01"
                                                               min="0"
                                                               class="form-control form-control-sm"
                                                               id="@(extra.Name)-@index"
                                                               name="@extraName"
                                                               value="@Model.Dec(Model.GetExtra(input, extra.Name))" />
                                                        @Html.ValidationMessage(extraName, new { @class = "text-danger small" })
                                                    </div>
                                                }
                                            </div>
                                            <div class="form-text">
                                                Leave a box empty for "not set". EMR 100 is standard.
                                            </div>
                                        }
                                    </div>

                                    <div class="col-md-4">
                                        <div class="js-global-note-area" hidden>
                                            <label class="form-label small mb-1" for="global-notes-@index">
                                                Global note (inherited)
                                            </label>
                                            <input type="text"
                                                   class="form-control form-control-sm js-inherited-note"
                                                   id="global-notes-@index"
                                                   value=""
                                                   readonly />
                                        </div>

                                        <div class="js-override-notes">
                                            <label class="form-label small mb-1" for="notes-@index">
                                                Override note
                                            </label>
                                            <input type="text"
                                                   maxlength="500"
                                                   class="form-control form-control-sm"
                                                   id="notes-@index"
                                                   name="@(prefix).Notes"
                                                   value="@input.Notes" />
                                            @Html.ValidationMessage(prefix + ".Notes", new { @class = "text-danger small" })
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="sticky-bottom bg-body border-top py-3">
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    }
}

@section Scripts {
    <script src="~/js/underwriting.js" asp-append-version="true"></script>
}
