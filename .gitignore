# SQL Server physical database files
*.mdf
*.ldf
*.ndf
*.dbmdl

# IMPORTANT:
# Do not add *.sql here.
# SQL scripts that create tables, seed approved demo data,
# and verify the schema should remain eligible for Git tracking.

# Node.js
node_modules/

# Python
__pycache__/
*.pyc

